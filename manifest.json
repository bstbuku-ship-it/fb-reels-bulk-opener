{
  "manifest_version": 3,
  "name": "FB Reels 批量开启",
  "version": "4.0",
  "description": "直接访问 Facebook 官方创建页自动获取真实专业主页编号，一键批量打开 Reels 创建页，支持自动预开日程本。",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://web.facebook.com/*",
    "https://business.facebook.com/*",
    "https://graph.facebook.com/*",
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Reels 批量开启",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
